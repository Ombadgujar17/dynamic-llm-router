# Copy to .env. Never commit .env or paste keys into chat.
OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Alternatively, Google Gen AI SDK also accepts GOOGLE_API_KEY.

# mock is safe and makes no API calls. live discovers model IDs via provider APIs.
ROUTER_MODE=mock

# Strict safe defaults: no inference calls that may incur charges.
ALLOW_PAID_INFERENCE=false
ALLOW_VERIFIED_FREE_TIER_INFERENCE=false
MAX_CALLS_PER_TASK=5
MAX_OUTPUT_TOKENS=1024

# For sensitive/restricted data, default is OpenAI only. Review provider terms before adding others.
SENSITIVE_DATA_ALLOWED_PROVIDERS=openai
MAX_TASK_COST_USD=0.00
SESSION_BUDGET_USD=0.00

# Optional JSON overrides keyed by "provider:model-id". Only add facts you have verified.
# Example shape (leave empty by default):
# MODEL_METADATA_JSON={"groq:YOUR_MODEL_ID":{"quality_score":4,"tier":"strong","capabilities":["general","coding","reasoning"],"input_usd_per_million":0.0,"output_usd_per_million":0.0,"free_tier_verified":true}}
MODEL_METADATA_JSON=

# Optional comma-separated model IDs whose free eligibility you personally verified.
# Format: provider:model-id,provider:model-id
VERIFIED_FREE_MODEL_IDS=
